apiVersion: apps/v1
kind: Deployment
metadata:
  name: thomastalking
  namespace: default
  labels:
    app: thomastalking-app
    examples.ai.gke.io/deployment-id: thomastalking-qDVHb
    examples.ai.gke.io/applied-by: gke-aiml-yaml
    examples.ai.gke.io/deployment-path: model-garden
spec:
  replicas: 1
  selector:
    matchLabels:
      app: thomastalking-app
  template:
    metadata:
      labels:
        app: thomastalking-app
        ai.gke.io/model: gemma-7b
        ai.gke.io/inference-server: text-generation-inference
        examples.ai.gke.io/source: model-garden
        examples.ai.gke.io/deployment-id: thomastalking-qDVHb
        examples.ai.gke.io/applied-by: gke-aiml-yaml
        examples.ai.gke.io/deployment-path: model-garden
    spec:
      containers:
      - name: inference-server
        image: us-docker.pkg.dev/vertex-ai/vertex-vision-model-garden-dockers/pytorch-hf-tgi-serve:20240328_0936_RC01
        resources:
          requests:
            cpu: 8
            memory: 29Gi
            ephemeral-storage: 80Gi
            nvidia.com/gpu: 1
          limits:
            cpu: 8
            memory: 29Gi
            ephemeral-storage: 80Gi
            nvidia.com/gpu: 1
        command: null
        args:
        - --model-id=google/gemma-7b
        - --cuda-memory-fraction=1.0
        env:
        - name: DEPLOY_SOURCE
          value: UI_HF_VERIFIED_MODEL
        - name: MAX_INPUT_LENGTH
          value: '512'
        - name: MAX_TOTAL_TOKENS
          value: '1024'
        - name: MAX_BATCH_PREFILL_TOKENS
          value: '2048'
        - name: TRUST_REMOTE_CODE
          value: 'true'
        - name: MODEL_ID
          value: google/gemma-7b
        - name: NUM_SHARD
          value: '1'
        - name: HUGGING_FACE_HUB_TOKEN
          valueFrom:
            secretKeyRef:
              name: thomastalking-secret
              key: hf_api_token
        volumeMounts:
        - mountPath: /dev/shm
          name: dshm
      volumes:
      - name: dshm
        emptyDir:
          medium: Memory
      nodeSelector:
        cloud.google.com/gke-accelerator: nvidia-l4
---
apiVersion: v1
kind: Service
metadata:
  name: thomastalking-service
  namespace: default
  labels:
    app: thomastalking-app
    examples.ai.gke.io/deployment-id: thomastalking-qDVHb
    examples.ai.gke.io/applied-by: gke-aiml-yaml
    examples.ai.gke.io/deployment-path: model-garden
spec:
  selector:
    app: thomastalking-app
  type: ClusterIP
  ports:
  - protocol: TCP
    port: 8000
    targetPort: 80
---
apiVersion: v1
kind: Secret
metadata:
  name: thomastalking-secret
  namespace: default
  labels:
    app: thomastalking-app
    examples.ai.gke.io/deployment-id: thomastalking-qDVHb
    examples.ai.gke.io/applied-by: gke-aiml-yaml
    examples.ai.gke.io/deployment-path: model-garden
type: Opaque
stringData:
  hf_api_token: eagle
